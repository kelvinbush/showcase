# Backend base URL (mk-backend).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk. Use the same Clerk instance as mk-backend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set to 1 to preview the interface with fixture data and no sign-in.
# Never set this in production.
NEXT_PUBLIC_DEMO_MODE=

# Demo only: open the dashboard without sign-in, on real data. The backend
# needs INVESTOR_OPEN_ACCESS=true. Never set this in production.
NEXT_PUBLIC_OPEN_ACCESS=
