# Backend base URL (mk-backend).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk. Use the same Clerk instance as mk-backend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set to 1 to preview the interface with fixture data and no sign-in.
# Never set this in production.
NEXT_PUBLIC_DEMO_MODE=

# Demo only: open the dashboard without sign-in, on real data. The backend
# needs INVESTOR_OPEN_ACCESS=true. Never set this in production.
NEXT_PUBLIC_OPEN_ACCESS=

# PostHog, for error reporting only. Leave unset locally so development never
# writes into the shared project. The key is the project key (phc_...), the
# same one the other apps use.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog source-map uploads, at production build time only. POSTHOG_API_KEY is
# a personal API key (phx_...) with the "Source map upload" preset.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Turns on /drill, a page of buttons that fail on purpose to prove error
# reporting works. A long random value, the same as the backend's. Unset = 404.
DRILL_TOKEN=
